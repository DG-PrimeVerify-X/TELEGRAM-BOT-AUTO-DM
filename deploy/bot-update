#!/usr/bin/env bash
set -euo pipefail
APP_DIR="/opt/TELEGRAM-BOT-AUTO-DM"
BACKUP_DIR="$APP_DIR/backups"
mkdir -p "$BACKUP_DIR"
cd "$APP_DIR"
STAMP=$(date +%Y%m%d-%H%M%S)
[ -f data/bot.db ] && cp data/bot.db "$BACKUP_DIR/bot-$STAMP.db" || true
git fetch origin
git pull --ff-only origin main
source .venv/bin/activate
pip install -r requirements.txt
python -m compileall -q app
sudo systemctl restart telegram-admin-bot
sleep 2
sudo systemctl --no-pager --full status telegram-admin-bot || true
echo "Update complete: $STAMP"
