[Unit]
Description=DgAutoaccept Telegram Admin Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/TELEGRAM-BOT-AUTO-DM
EnvironmentFile=/opt/TELEGRAM-BOT-AUTO-DM/.env
ExecStart=/opt/TELEGRAM-BOT-AUTO-DM/.venv/bin/python -m app.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
